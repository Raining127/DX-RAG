    {
      "chunk_id": "f7017394-093c-4e03-98b4-2513089a96b2",
      "file_id": "bc7e515f-c5e0-4655-94f1-0c28a915b0bf",
      "file_name": "it_security_policy.md",
      "collection_name": "t2001-novatech-pilot-01",
      "chunk_index": 7,
      "content": "NovaTech（诺瓦科技）信息安全制度 > 钓鱼邮件与可疑链接\n\n遇到要求紧急付款、修改收款账户或输入密码的邮件，应通过已知联系方式另行核实，不直接使用可疑邮件提供的电话号码。未知附件、二维码和登录页面在核实前不要打开或输入信息。客户或领导的显示姓名不能单独证明邮件可信。\n发现可疑邮件可通过公司邮件举报入口或 IT 服务台报告，保留原邮件，不在团队群中继续转发危险链接。已经点击或下载时也应如实说明，不因担心追责而延迟报告。",
      "metadata": {
        "collection_name": "t2001-novatech-pilot-01",
        "file_name": "it_security_policy.md",
        "source_file": "uploads/t2001-novatech-pilot-01/it_security_policy.md",
        "ingestion_status": "SUCCESS",
        "chunk_index": 7,

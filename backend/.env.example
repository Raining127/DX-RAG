# ============================================================
# DX-RAG Backend Configuration Template
# Copy this file to .env and adjust values for your environment
# ============================================================

# --- API Keys (Optional — required only when using the feature) ---
# DeepSeek Chat API key (required for LLM answer generation)
DEEPSEEK_API_KEY=
# DashScope (Qwen-VL) API key (required for image PDF OCR fallback)
DASHSCOPE_API_KEY=

# --- Application ---
APP_NAME=dx-rag-demo

# --- CORS ---
# JSON array of allowed origins, e.g. '["http://localhost:3000"]'
# Use '["*"]' to allow all origins (default for local/trusted network)
CORS_ORIGINS=["*"]

# --- ChromaDB ---
# Default collection name when not provided in request
CHROMA_COLLECTION=knowledge_chunks
# ChromaDB persistence directory (relative to backend/)
CHROMA_PERSIST_DIR=chroma_db

# --- Embedding ---
# Path to local embedding model directory (relative to backend/)
EMBED_MODEL=models/bge-small-zh-v1.5

# --- File Storage ---
# Root upload directory (relative to backend/)
UPLOAD_DIR=uploads
# Maximum single file upload size in MB
MAX_UPLOAD_SIZE_MB=50

# --- Chunking ---
# Maximum chunk size in characters
MAX_CHUNK_SIZE=800
# Chunk overlap in characters
CHUNK_OVERLAP=120

# --- LLM (DeepSeek Chat) ---
# Temperature for answer generation (0.0–1.0)
LLM_TEMPERATURE=0.2
# Maximum output tokens per answer
LLM_MAX_TOKENS=2048
# API request timeout in seconds
LLM_TIMEOUT=60
# Maximum retry attempts after initial request (total = 1 + this value)
LLM_MAX_RETRIES=2

# --- Retrieval ---
# Default number of chunks to retrieve (valid range: 1–20)
DEFAULT_TOP_K=5
# Minimum allowed top_k value
TOP_K_MIN=1
# Maximum allowed top_k value
TOP_K_MAX=20

# --- Conversation ---
# Maximum number of history messages to process (most recent N)
MAX_HISTORY_LENGTH=20

# --- RAG Context ---
# Maximum total characters in assembled context (no mid-chunk truncation)
MAX_CONTEXT_CHARS=4000

# --- File Preview ---
# Maximum characters returned in file preview
MAX_PREVIEW_CHARS=5000

# --- Hybrid Retrieval ---
# Minimum final_score for a chunk to be included in context (range 0.0–1.0)
MIN_RELEVANCE_SCORE=0.30
